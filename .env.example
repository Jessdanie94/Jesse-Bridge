   SHOPIFY_STORE_DOMAIN=wonderful-gems-point.myshopify.com
   SHOPIFY_API_SECRET=...
   SELLVIA_API_KEY=... (from Sellvia Menu → Settings → API)
   ADMIN_TOKEN=...
   DB_PATH=./data/bridge.db (SQLite file; use a persistent disk on Render)
   LOG_LEVEL=info
   ALERT_WEBHOOK_URL=... (optional Slack-compatible incoming webhook for failure alerts)
   APPROVAL_MAX_ATTEMPTS=5 (optional)
   APPROVAL_BASE_DELAY_MS=1000 (optional)
